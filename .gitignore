# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report/
/test-results/
/blob-report/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# videos uploaded by admins through /admin/lessons (large binaries, not source)
/public/videos/lessons/

# narration audio — fully migrated to Vercel Blob (see prisma/migrate-audio-to-blob.ts
# and AudioAsset.audioUrl); these local copies are generation source/cache only, never
# served directly or deployed — keeping 1.4GB+ of mp3s out of git and out of every deploy
# was the whole point of that migration
/public/audio/

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# sqlite database
*.db
*.db-journal
*.db-shm
*.db-wal

# Python virtualenvs (bots/) and bytecode caches
.venv/
**/__pycache__/
*.pyc

# generated PWA service worker (built from src/app/sw.ts by @serwist/next)
/public/sw.js
/public/sw.js.map
/public/swe-worker-*.js
/public/swe-worker-*.js.map

# resumable progress map from the one-time public/audio -> Vercel Blob
# migration (prisma/migrate-audio-to-blob.ts) — local working state, not source
/prisma/audio-blob-map.json

# resumable checkpoint for the LLM story-topic tagging script
# (prisma/tag-story-topics.ts) — local working state, not source
/prisma/.tag-story-topics-progress.json

# Capacitor native projects (ios/, android/) ARE committed — they hold
# native config/signing that can't be regenerated by one command alone.
# Only their local build output and machine-specific files are ignored.
/ios/App/Pods/
/ios/App/build/
/ios/App/DerivedData/
/ios/.build/
/android/.gradle/
/android/app/build/
/android/build/
/android/local.properties
/android/captures/
/android/*.iml
/android/app/*.iml
/android/.idea/
