// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// role is one of: owner | admin | student
// (kept as String because SQLite has no native enum type in Prisma)
model User {
  id                   String                 @id @default(cuid())
  email                String                 @unique
  name                 String?
  // One of AVATAR_IDS in src/lib/avatars.ts (e.g. "matryoshka_calm") — never
  // a file path or URL. The avatar itself is a client-rendered component,
  // not a stored asset; this column is only ever a tiny string.
  avatarId             String                 @default("matryoshka_calm")
  role                 String                 @default("student")
  // bcrypt hash, never the plaintext. Null on accounts created before real
  // password auth existed (the old email-only demo flow) — those users are
  // asked to set a password on their next login (see src/lib/auth.ts).
  passwordHash         String?
  // Bumped by "sign out other devices"/change-password/reset-password —
  // every issued session token embeds the version it was signed with (see
  // session-token.ts), so incrementing this invalidates every
  // previously-issued token at once with no server-side session table to
  // store or clean up.
  sessionVersion       Int                    @default(0)
  stripeCustomerId     String?                @unique
  // IANA time zone name reported by the browser (e.g. "America/Tijuana"),
  // written by POST /api/timezone. Null until the user's first page load
  // after this column existed — every reader falls back to UTC, which is
  // exactly the behaviour that was wrong before, so a null here is a
  // "not known yet", never a preference.
  //
  // It exists because the day boundary of the activity streak has to be
  // the LEARNER's midnight, not the server's: a Tijuana evening (UTC-7)
  // is already the next UTC day, so two adjacent study days collapsed or
  // split and the streak reset for no visible reason (see PROGRESS.md
  // 7.68). A cookie alone would not do — badge evaluation runs in
  // after(), and a public profile is rendered for a visitor whose time
  // zone is not the profile owner's.
  timezone             String?
  createdAt            DateTime               @default(now())
  subscriptions        Subscription[]
  lessonProgress       LessonProgress[]
  voiceSubmissions     VoiceSubmission[]
  examAttempts         ExamAttempt[]
  flashcardProgress    FlashcardProgress[]
  storyReadingProgress StoryReadingProgress[]
  badges               UserBadge[]
  // Lazily generated on first visit to the referral tab/link (see
  // src/lib/referral.ts) rather than at signup — most users never open
  // that tab, so this avoids burning a code (and a uniqueness retry loop)
  // for every account ever created.
  referralCode         String?                @unique
  // Set once, at registration, from a ?ref= link — never changed
  // afterwards ("first touch wins"). SetNull (not Cascade) on delete: if a
  // referrer's account is later deleted, the people they referred keep
  // their own accounts, they just lose the (already-resolved) attribution.
  referredByUserId     String?
  referredBy           User?                  @relation("UserReferrals", fields: [referredByUserId], references: [id], onDelete: SetNull)
  referredUsers        User[]                 @relation("UserReferrals")
  referralRewardsEarned ReferralReward[]
  // Off by default — a badge/streak profile is only reachable at
  // /u/[publicHandle] once the user explicitly opts in from /profile.
  // publicHandle is lazily generated the same way referralCode is (see
  // src/lib/public-profile.ts): most accounts never enable this, so
  // there's no reason to burn a handle at signup.
  publicProfileEnabled Boolean                @default(false)
  publicHandle         String?                @unique
  ownedGroups          Group[]                @relation("GroupOwner")
  groupMemberships     GroupMember[]
  wordGameProgress     WordGameProgress[]
}

// status is one of: active | trialing | past_due | canceled | incomplete_expired
// (kept as String because SQLite has no native enum type in Prisma)
model Subscription {
  id                   String   @id @default(cuid())
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan                 String
  status               String   @default("active")
  currentPeriodEnd     DateTime

  // "stripe" (web) | "revenuecat" (native App Store / Play Billing).
  // Defaults to "stripe" so every existing row backfills correctly.
  provider             String   @default("stripe")

  stripeSubscriptionId String?  @unique
  stripeCustomerId     String?

  // RevenueCat/native-store fields. original_transaction_id is the stable
  // per-purchase key both Apple and Google keep across renewals, so it's
  // what we dedupe webhook events on (like stripeSubscriptionId for Stripe).
  rcOriginalTransactionId String? @unique
  rcAppUserId             String?
  rcStore                 String?

  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([userId])
  // Covers getLatestSubscription's findFirst({ where: { userId }, orderBy:
  // { createdAt: "desc" } }) — the hottest query in the access-control
  // path (run on every lesson/exam view, twice: once in proxy.ts, once in
  // the page itself) — without this, that orderBy falls back to sorting
  // the userId-filtered rows in memory instead of walking the index in order.
  @@index([userId, createdAt])
  @@index([stripeSubscriptionId])
  @@index([rcOriginalTransactionId])
}

// One row per lesson a user has ATTEMPTED (pass or fail) — written by
// POST /api/progress on every "Comprobar" check, upserted so this is always
// the most recent attempt for that lesson. Read two ways: (1) filtered to
// `passed: true` for the course-progress bars and /profile's per-lesson
// result cards (preserves the original "only passes count" semantics),
// and (2) unfiltered by GET /api/progress?level=&lesson=, which
// ExercisesTab uses to restore exactly the state a student left a lesson
// in — right down to which exercises they got right or wrong — instead of
// showing a blank form on a repeat visit, whether or not they'd passed yet.
model LessonProgress {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  level       String
  lessonSlug  String
  // Percentage score (0-100) of the attempt that triggered this row/update.
  score       Int      @default(0)
  // Whether THIS attempt cleared the pass threshold — distinct from score,
  // since callers that only care about "has this lesson been passed"
  // (course-progress bars, /profile) must filter on this, not infer it from
  // score, now that failing attempts are saved too.
  passed      Boolean  @default(true)
  // JSON-encoded string[]: a short human-readable label per exercise the
  // student got wrong on this attempt (e.g. the fill-blank prompt or the
  // multiple-choice question), used to build "revisa esto" hints on
  // /profile. "[]" when the student got everything right.
  mistakes    String   @default("[]")
  // JSON-encoded AnswerMap (see src/lib/lessons/scoring.ts) — every answer
  // the student gave on this attempt, restored verbatim into ExercisesTab
  // on a repeat visit so the graded view (not just the aggregate score)
  // reappears exactly as left.
  answers     String   @default("{}")
  completedAt DateTime @default(now())

  @@unique([userId, level, lessonSlug])
  @@index([userId])
}

// One row per exam attempt (the 10-lesson milestone exams, see
// src/lib/exams/). Every attempt is kept (not just the best/first), so a
// student's exam history is visible on /profile. breakdown is a
// JSON-encoded Record<skillAreaId, { earned, total, percentage }> letting
// the profile show which skill areas (alphabet, greetings, numbers...) are
// solid vs. need review, not just one aggregate number.
model ExamAttempt {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  level       String
  examSlug    String
  earned      Int
  total       Int
  percentage  Int
  passed      Boolean
  breakdown   String
  completedAt DateTime @default(now())

  @@index([userId, level, examSlug])
}

// A short story or folk tale in the "Cuentos / Lecturas" reading library.
// level uses the CEFR scale (A1-C1), one step further than course levels
// (which stop at B2) since some readings target advanced students who have
// finished the course track. isPremium gates the full text/audio behind an
// active subscription, mirroring the lesson access-control check.
model Story {
  id            String   @id @default(cuid())
  title         String
  author        String
  level         String
  text          String
  // Short intro shown on the catalog card and above the text on the
  // reader page — the "summary" a student reads before committing to
  // the full story. Written in Spanish only for every existing row (a
  // confirmed 325/325 data gap, not a rendering bug — see AUDIT.md).
  description   String?
  // Russian version of `description` — null for every row as of this
  // column's introduction; writing the actual Russian text is a
  // separate content task (see PROGRESS.md's open items), not something
  // this column addition does on its own. Rendering must fall back to
  // `description` (Spanish) when this is null, on BOTH locales — never
  // hide the summary block on /ru just because this field is empty.
  descriptionRu String?
  // Spanish parallel translation, paragraph-aligned with `text` via the
  // same newline-per-paragraph convention (see splitStoryParagraphs) —
  // powers the "show translation" toggle on the reader page.
  translationEs String?
  audioUrl      String?
  isPremium     Boolean  @default(false)
  // Reserved for the "Premium" (lifetime) plan specifically — a
  // "standard" (monthly/annual) subscriber is otherwise fully entitled
  // (isPremium above already covers free vs. any-paid-plan) but still
  // can't read this one. Seeded by prisma/set-premium-only-stories.ts
  // (all C1 + a deterministic ~half of B2, landing the Premium-exclusive
  // share at ~30% of the catalog per the access-tier policy) and then
  // hand-curated per-story via /admin/stories, same "script sets a
  // default, staff corrects" pattern as CURATED_FREE_STORIES.
  premiumOnly   Boolean  @default(false)
  // Story topic for the catalog filter — one of storyTopics in
  // src/lib/stories.ts, "other" as the fallback bucket for anything the
  // tagging heuristic (prisma/tag-story-topics.ts) couldn't confidently
  // place. Stored as the topic KEY (e.g. "daily_life"), never a
  // localized label, which live in the dictionaries instead — so the
  // filter reads correctly on both /es and /ru. Deliberately does NOT
  // cover "classic retelling vs. original story" — that's a source
  // distinction, not a theme, and a single-value topic field would force
  // every classic retelling into one bucket regardless of its actual
  // subject. See isClassicStory (derived from `author`) for that axis.
  topic         String   @default("other")
  // Set the moment a staff member saves this row through /admin (see
  // src/app/api/admin/stories/save) — marks it as human-reviewed content.
  // Null means it has only ever been written by a seed/generation script.
  // Batch content scripts (prisma/seed-stories.ts) must treat a non-null
  // value as "do not silently overwrite" — added after a real incident
  // where a re-run of a seed script clobbered a good human-reviewed
  // Spanish translation with regenerated text. See CONTENT_INTEGRITY.md.
  reviewedAt    DateTime?
  // Estimated minutes to read `text` (word count / reading-speed constant,
  // rounded up, minimum 1) — computed once at write time (see
  // src/lib/stories.ts's estimateReadingMinutes and api/admin/stories/save)
  // rather than on every catalog request, so the deliberately lean
  // catalog query (see stories-catalog.ts's own comment) never has to
  // pull the full `text` column just to show a number on a card. Null
  // only for rows written before this column existed and not yet covered
  // by the one-time backfill script.
  readingMinutes Int?
  // Whole-story narration as ONE continuous file — a real <audio> element
  // playing this plays natively in the background/with the screen locked,
  // unlike the per-sentence clip chain (still the fallback below), which
  // browsers/OSes don't reliably keep advancing once backgrounded (each
  // sentence-to-sentence transition looks like starting new playback with
  // no fresh user gesture). Built by prisma/concat-story-audio.ts via
  // ffmpeg concatenation of the EXISTING per-sentence AudioAsset clips —
  // never new narration/TTS. Null until that script has run for this
  // story (or permanently, for the handful of only-partially-narrated
  // stories it deliberately skips — see check-story-audio.ts); a null
  // here means the reader falls back to the per-sentence chain.
  fullAudioUrl  String?
  // Cumulative start-second offset of every sentence within
  // `fullAudioUrl`, JSON array in the same order buildStoryQueue()
  // produces (src/lib/stories.ts) — e.g. [0, 3.2, 7.8, ...]. Drives the
  // reader's sentence highlight/seek via audio.ontimeupdate once a
  // single-file track is playing, replacing the old per-clip onended
  // boundary. Same JSON-string-on-a-model-field pattern already used for
  // LessonContent/exam content below.
  sentenceOffsetsJson String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([level])
}

// Admin-edited lesson content (grammar/vocabulary/exercises), stored as a
// JSON string matching the LessonContent shape in src/lib/lessons/types.ts.
// getLessonContent() checks this table first and falls back to the static
// src/lib/lessons/content.json bundled with the app — so the two seed
// lessons keep working even before an admin touches anything, and any
// lesson an admin creates/edits here overrides the static file (and,
// unlike file edits, actually persists on serverless hosting like Vercel).
model Lesson {
  id          String   @id @default(cuid())
  level       String
  lessonSlug  String
  contentJson String
  updatedBy   String?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@unique([level, lessonSlug])
}

// Admin-edited exam content (skill areas + exercises), stored as a JSON
// string matching the ExamContent shape in src/lib/exams/types.ts — same
// override-table pattern as Lesson above. getExamContent() checks this
// table first and falls back to the static src/lib/exams/content.json, so
// a1-exam-1 keeps working unmodified and every future exam (a1-exam-2,
// a1-exam-3...) can be authored entirely through /admin/exams without
// touching the JSON file or redeploying.
model Exam {
  id          String   @id @default(cuid())
  level       String
  examSlug    String
  contentJson String
  updatedBy   String?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@unique([level, examSlug])
}

// A student's uploaded recording of themselves reading a word/phrase aloud
// (pronunciation practice, read-aloud practice). One row per attempt — kept
// as a history rather than overwritten, so a student can hear how they've
// improved. Only ever readable by the student who made it (see
// GET /api/voice-submissions) — there is no admin review UI yet.
model VoiceSubmission {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  level      String
  lessonSlug String
  // Identifies which practice item this recording belongs to, e.g. the
  // vocabulary word or readingPractice sentence (stable across content
  // edits because it's the Russian text itself, not an array index).
  itemKey    String
  audioUrl   String
  createdAt  DateTime @default(now())

  @@index([userId, level, lessonSlug, itemKey])
}

// Per-flashcard "known" flag, server-backed so it survives a device switch
// or app reinstall (a mobile-launch requirement — see rusofasil_project_state
// memory). Mirrors the shape of the legacy localStorage-only map in
// src/lib/flashcard-progress.ts; the client still writes to localStorage
// first for instant UI feedback, then syncs here in the background.
model FlashcardProgress {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  cardId        String
  known         Boolean   @default(true)
  // Leitner-box spaced repetition, laid down for the upcoming recall/typing
  // trainer and match game (both need "which words is this user weak on"
  // beyond the coarse known/unknown flag above). box: 0 = new/learning,
  // 1 = review, 2 = mastered. correctStreak resets to 0 on any miss;
  // reaching 2 in a row promotes the card to the next box.
  box           Int       @default(0)
  correctStreak Int       @default(0)
  lastSeenAt    DateTime?
  updatedAt     DateTime  @default(now()) @updatedAt

  @@unique([userId, cardId])
  @@index([userId])
}

// Per-story reading/listening progress, server-backed for the same reason
// as FlashcardProgress above. Named StoryReadingProgress (not StoryProgress)
// to avoid colliding with the unrelated Story content model.
model StoryReadingProgress {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  storyId     String
  currentPage Int
  queueIndex  Int?
  totalPages  Int
  percent     Int
  isCompleted Boolean  @default(false)
  updatedAt   DateTime @default(now()) @updatedAt

  @@unique([userId, storyId])
  @@index([userId])
}

// Pre-generated pronunciation audio for lesson content (vocabulary words,
// grammar examples, readingPractice sentences), mirroring Story.audioUrl's
// pattern but at per-item granularity. Exists so SpeakButton can play a
// real file instead of the browser's Web Speech API — the latter is
// unreliable or absent in a native/WebView mobile context (see
// rusofasil_project_state memory). itemKey is the Russian text itself
// (same "stable across content edits" convention as VoiceSubmission.itemKey),
// not an array index. Populated by prisma/generate-lesson-audio.ts — a paid
// OpenAI TTS call per item, so this table is filled incrementally, not all
// at once; SpeakButton falls back to browser synthesis for any item not
// yet cached here.
// Single shared cache for every pre-generated (paid, OpenAI) narration clip
// in the app — stories, lesson pronunciation, flashcard words, and future
// content types all write here instead of each rolling its own table.
// Nothing but the generate-*-audio.ts CLI scripts ever writes to this model
// (they're the only code that holds OPENAI_API_KEY) — no request handler
// under src/app/api reads that key or calls the TTS provider, so ordinary
// users have no code path that can trigger a paid generation.
//
// (contentType, contentId, itemKey) identifies WHERE a clip belongs (e.g.
// story "abc123" paragraph 3 sentence 1, or lesson "a1-3"'s pronunciation
// for a specific word/example). `textHash` identifies WHAT was actually
// synthesized: a generation run only re-synthesizes an item when the
// current text's hash no longer matches the stored one (content was
// edited), so fixing a typo in one already-narrated sentence costs one
// clip, not a re-run of the whole story/lesson/corpus — see
// src/lib/audio-assets.ts.
model AudioAsset {
  id          String   @id @default(cuid())
  contentType String // "story" | "lesson" | "flashcard"
  contentId   String // Story.id | `${level}-${lessonSlug}` | FlashcardCard.id
  itemKey     String // position/id of the item within its content (see call sites)
  textHash    String // sha256 of the exact sanitized text last synthesized
  text        String // that text, kept for audit/debugging and for lesson-audio's by-word lookup
  voice       String
  model       String // e.g. "gpt-4o-mini-tts" — lets a future voice/model switch be told apart from old clips
  audioUrl    String
  // Nullable: existing rows predate this column. Populated at generation
  // time going forward (see generate-story-audio.ts) and by a one-time
  // backfill script for rows that already existed — see
  // prisma/backfill-audio-durations.ts. Feeds the story player's
  // whole-track scrubber and Media Session setPositionState(), both of
  // which need every segment's length known up front rather than
  // discovered lazily client-side as each clip plays.
  durationSeconds Float?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([contentType, contentId, itemKey])
  @@index([contentType, contentId])
}

// Architectural foundation for the planned "linguistic terms glossary" —
// a searchable reference of the METALANGUAGE the course itself uses
// (aspecto perfectivo, caso genitivo, participio activo...), distinct from
// /api/dictionary/translate (which looks up arbitrary Russian WORDS a
// student encounters in a story, via a free external API, not course
// terminology). term/definition are always Spanish, matching the course's
// language policy (see src/lib/lessons/content.ts); russianEquivalent is
// the term's standard Russian name, so a student can map "aspecto
// perfectivo" to "совершенный вид" directly. category groups related
// entries for the future search/filter UI (e.g. "casos", "aspecto",
// "participios"). relatedLessons is a JSON-encoded string[] of lesson
// slugs ("b1-19") where the term is first taught, for future cross-linking
// — kept as JSON rather than a join table since this is a small reference
// set, not a high-write relation.
model GlossaryTerm {
  id                String   @id @default(cuid())
  slug              String   @unique
  term              String
  definition        String
  russianEquivalent String
  transcription     String?
  category          String
  // A short paragraph bridging to Russian — how this concept behaves (or
  // doesn't exist) in Russian grammar, e.g. "en español el sustantivo no
  // cambia de forma; en ruso sí, según el caso". Optional because it only
  // makes sense for the "partes-de-la-oracion" category (Spanish
  // metalanguage terms) — the older Russian-concept entries (aspecto,
  // casos...) already ARE the Russian explanation, so this would be
  // redundant for them.
  russianComparison String?
  // JSON-encoded { es: string; ru: string }[] — replaces the old singular
  // exampleRu/exampleEs pair so a term can carry more than one example
  // sentence (the whole point of "examples" as an array: showing the
  // pattern in more than one live context). Same JSON-string-column
  // pattern as relatedLessons below, for the same reason (small reference
  // table, not worth a join table).
  examples          String   @default("[]")
  relatedLessons    String   @default("[]")
  // Same human-review marker as Story.reviewedAt — set on every /admin save,
  // checked by prisma/seed-glossary.ts before overwriting an existing row.
  reviewedAt        DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([category])
}

// A single vocabulary flashcard shown on /vocabulary. Previously these
// lived as ~4,500 lines of hand-written literal arrays across
// src/lib/flashcards/*.ts, imported directly by the "use client"
// FlashcardsApp component — which meant the ENTIRE bank shipped in the
// browser JS bundle on every visit, regardless of which category/level a
// student actually opened. Moving to a DB-backed model (mirroring Story
// and GlossaryTerm) fixes that: the client now fetches only the filtered
// slice it needs from GET /api/flashcards?category=&level=, and new words
// can be added by an admin without a code change or redeploy.
//
// `id` intentionally stays a stable, meaningful string (not just a cuid
// default) for EXISTING migrated cards — FlashcardProgress.cardId
// references it directly, and a student's "known" flag must survive this
// migration. New admin-created cards fall back to the cuid() default,
// which is fine since nothing referenced their id before creation.
model FlashcardCard {
  id            String   @id @default(cuid())
  category      String // FlashcardCategory union — see src/lib/flashcards.ts
  level         String // FlashcardLevel: A1 | A2 | B1 | B2 | C1
  emoji         String
  russian       String
  transcription String
  translationEs String
  exampleRu     String
  exampleEs     String
  // JSON-encoded WordRelation[] ({ word, translation }) — same
  // small-reference-set-as-JSON-column reasoning as GlossaryTerm.examples
  // above; a join table would be overkill for a handful of related words
  // per card.
  synonyms      String   @default("[]")
  antonyms      String   @default("[]")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([category])
  @@index([level])
}

// A Russian idiom/proverb shown on /vocabulary's "Idioms" tab. Same
// rationale and migration story as FlashcardCard above: previously
// ~7,400 lines of literal arrays (src/lib/idioms/{daily,proverbs,literary}.ts)
// bundled whole into the client. id stays stable for the same
// FlashcardProgress.cardId reason (idioms use the same known/unknown
// tracking as flashcards).
model Idiom {
  id                 String   @id @default(cuid())
  category           String // IdiomCategory: daily | proverbs | literary
  // CEFR level (StoryLevel: A1 | A2 | B1 | B2 | C1), added after the fact —
  // every pre-existing row defaults to "A2" as a safe placeholder (not "A1",
  // which would understate literary idioms; not null, which would just
  // create a third, unlabeled state). This is a temporary stand-in, not a
  // real classification — re-tagging the existing 771 rows by actual
  // difficulty is separate, future content work.
  level              String   @default("A2")
  phrase             String
  literalTranslation String
  spanishEquivalent  String
  explanation        String
  contextExampleRu   String
  contextExampleEs   String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([category])
  @@index([level])
}

// A badge a user has earned (streaks, exam milestones, grammar-case
// mastery, vocabulary size). The badge catalog itself (title, description,
// icon, unlock condition) lives in code (src/lib/badges/catalog.ts), not
// here — it's static content with no admin-editing need yet, same
// reasoning as the static lessons/exams JSON before the Lesson/Exam
// override tables existed. This table only records the fact and moment a
// given user unlocked a given badge. badgeId is a stable slug from the
// catalog (e.g. "streak-7", "genitive-master"), not a foreign key, so the
// catalog can be edited/reordered in code without a migration.
model UserBadge {
  id       String   @id @default(cuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badgeId  String
  earnedAt DateTime @default(now())

  @@unique([userId, badgeId])
  @@index([userId])
}

// One row per referral that has actually paid off — created exactly once,
// the moment the REFERRED user completes their first real checkout (see
// src/lib/referral.ts). referredUserId is unique so this table itself is
// the idempotency guard: even a duplicated Stripe webhook delivery for the
// same checkout can't grant the referrer a second reward, no separate
// "already rewarded" flag needed anywhere else.
model ReferralReward {
  id             String   @id @default(cuid())
  referrerUserId String
  referrer       User     @relation(fields: [referrerUserId], references: [id], onDelete: Cascade)
  referredUserId String   @unique
  grantedDays    Int
  createdAt      DateTime @default(now())

  @@index([referrerUserId])
}

// A study group: a small, invite-only circle whose members can see each
// other's streak/level/badge count on the group page (see
// src/lib/groups.ts) — that visibility is scoped to fellow members only,
// unlike the opt-in PUBLIC profile above, so it doesn't need
// publicProfileEnabled. Deleting the owner's account deletes the group
// entirely (Cascade) rather than leaving it ownerless.
model Group {
  id          String        @id @default(cuid())
  name        String
  inviteCode  String        @unique
  ownerUserId String
  owner       User          @relation("GroupOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  members     GroupMember[]
  createdAt   DateTime      @default(now())

  @@index([ownerUserId])
}

model GroupMember {
  id       String   @id @default(cuid())
  groupId  String
  group    Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt DateTime @default(now())

  @@unique([groupId, userId])
  @@index([groupId])
  @@index([userId])
}

// A single pre-generated Sopa de Letras / crossword grid. Deliberately
// generated ONCE offline by `npm run generate:word-games` (prisma/generate-word-games.ts)
// from the existing FlashcardCard bank and stored here — the app never runs
// the placement algorithm at request time, only reads a finished row. See
// docs/plan-2026-08-19-three-windows.md (Window 1) for the full rationale
// (avoiding unpredictable runtime compute/API cost).
model WordGamePuzzle {
  id       String              @id @default(cuid())
  type     String // WordGameType: WORD_SEARCH | CROSSWORD — see src/lib/word-games/types.ts
  level    String // FlashcardLevel: A1 | A2 | B1 | B2 | C1
  // Difficulty rung within [type, level], starting at 1 — self-paced like
  // the rest of the app (see src/lib/flashcards/level-progress.ts): every
  // rung stays playable, WordGameProgress only drives a completed-checkmark
  // badge on the picker, never a lock.
  sequence Int
  // Expert-tier WORD_SEARCH puzzle whose words bend mid-path instead of
  // running in a single straight line (src/lib/word-games/snake-word-search.ts).
  // Always false for CROSSWORD. Surfaced as a ★ badge on the picker grid —
  // kept as a real column (not embedded in `words`) so the picker can
  // render it without parsing every puzzle's JSON.
  curved   Boolean             @default(false)
  // Reserved for the "Premium" (lifetime) plan — a "standard" subscriber
  // is otherwise fully entitled to word games. Every `curved` puzzle is
  // always also `premiumOnly` (curved is already, by construction, the
  // hardest tail of each [type, level] ladder — see
  // prisma/set-premium-only-word-games.ts), plus enough of the hardest
  // non-curved rungs (by `sequence`, the ladder's own natural difficulty
  // order) to land the Premium-exclusive share at ~30-35% overall, per
  // the access-tier policy. Checked in ADDITION to `curved` wherever
  // access is gated (see entitlement.ts), not instead of it — so a future
  // puzzle-generation script that sets `curved` without also setting this
  // still degrades safely rather than accidentally unlocking a ★ puzzle.
  premiumOnly Boolean            @default(false)
  // Vocabulary-category slug this puzzle's words were drawn from
  // ("comida", "ropa" — the /es/vocabulary/<slug> segment), or null when
  // the puzzle draws from the level-wide mixed pool. Only the 80 free
  // puzzles are ever themed; see src/lib/word-games/topics.ts for the
  // frozen rung -> category table and how it was derived. Stored on the
  // row rather than recomputed at request time so a page can be titled
  // from what its words ACTUALLY are: if a future rerun leaves a rung
  // mixed because its category no longer has enough words, the title
  // follows the data instead of a stale lookup table.
  topic    String?
  // JSON-encoded { size: number, grid: string[][] } — the finished letter
  // grid, ready to render as-is.
  gridData String
  // JSON-encoded WordPlacement[]: { word, clue, row, col, direction,
  // number?, path? } (number only set for CROSSWORD, used as the clue-list
  // index; path only set for curved WORD_SEARCH words — the ordered list of
  // cells the word actually bends through, row/col/direction still point at
  // path[0] for type uniformity but direction is meaningless for these).
  // `clue` is the FlashcardCard.translationEs of the placed word (for
  // WORD_SEARCH, always the direct translation — no blank to spoil, unlike
  // CROSSWORD's masked-example clue for B1+), captured at generation time
  // rather than joined live, so a puzzle keeps working even if the source
  // card is later edited or removed.
  words    String

  progress WordGameProgress[]

  createdAt DateTime @default(now())
  // When this row was last written. Feeds `lastmod` in sitemap.xml, which
  // is this site's only mass-recrawl signal: Search Console's manual
  // "request indexing" is capped at ~10 URLs a day, so the 138 URLs the
  // 02.09.2026 regeneration changed could never be submitted by hand.
  //
  // Optional, not required, on purpose. It is added to the production
  // database by prisma/ensure-schema-sync.ts, which can only ever ADD a
  // nullable column — a required DateTime would be null on all 3000
  // existing rows and Prisma would fail reading them. Rows with no date
  // are emitted without lastmod rather than with a fallback: an invented
  // date on an unchanged URL teaches a crawler to distrust every lastmod
  // in the file.
  updatedAt DateTime? @updatedAt

  @@unique([type, level, sequence])
  @@index([type, level])
}

model WordGameProgress {
  id          String         @id @default(cuid())
  userId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  puzzleId    String
  puzzle      WordGamePuzzle @relation(fields: [puzzleId], references: [id], onDelete: Cascade)
  completedAt DateTime       @default(now())
  timeSeconds Int?
  // Client-reported: true if the "reveal a letter" hint was used at any
  // point during this attempt. Not tamper-proof (the client could lie),
  // same trust level as LessonProgress.mistakes elsewhere in this schema
  // — this is for the completion celebration/UI to distinguish a clean
  // solve, not an anti-cheat mechanism.
  usedHint    Boolean        @default(false)

  @@unique([userId, puzzleId])
  @@index([userId])
}

// One offline grammar-check result for a single (entity, field) pair —
// see prisma/check-grammar.ts (Window 3, docs/plan-2026-08-19-three-windows.md).
// Written ONLY by that CLI script, run before content ships; the app never
// calls an LLM for this at request time, only reads the stored verdict.
model GrammarCheckResult {
  id          String   @id @default(cuid())
  // "FlashcardCard" | "Idiom" | "GlossaryTerm" | "Story" — no FK, since a
  // single row here addresses one field on one of several unrelated
  // models (same reasoning AudioAsset already uses for contentType/contentId).
  entityType  String
  entityId    String
  fieldName   String
  // sha256 of the exact text last checked. On every re-run, check-grammar.ts
  // skips any (entityType, entityId, fieldName) whose current text still
  // hashes to this value and whose status is CLEAN — the whole point being
  // to never re-spend an LLM call re-checking text that hasn't changed.
  contentHash String
  status      String   @default("PENDING") // GrammarCheckStatus: PENDING | CLEAN | FLAGGED
  // JSON-encoded { errorType, excerpt, explanation, suggestion }[] — "[]" when CLEAN.
  findings    String   @default("[]")
  checkedAt   DateTime @default(now())

  @@unique([entityType, entityId, fieldName])
  @@index([status])
}

// Runtime-writable state layered on top of the static `mediaData.json`
// catalog (title/vocab/exercises stay in the JSON file, which ships with
// the code — no runtime writes needed there). This table exists because
// `mediaData.json` lives inside the deployed app's own source tree, and
// Vercel's serverless functions have a read-only filesystem: any
// `fs.writeFile()` against it in production silently fails, which is why
// admin-generated subtitles never used to persist there. Read as an
// overlay in src/lib/media/data.ts — a null/absent field here means "fall
// back to whatever the static JSON has for this id."
model MediaOverride {
  id      String @id @default(cuid())
  mediaId String @unique

  // JSON-encoded SubtitleLine[], set by the admin "Generar subtítulos con
  // Claude" action. Overrides mediaData.json's own `subtitles` field when
  // present.
  subtitles String?

  // EmbedStatus: "ok" | "blocked". Set by the automated YouTube Data API
  // check (src/lib/media/checkEmbeds.ts) or manually via the admin panel.
  embedStatus   String?
  lastCheckedAt String?
  // Appended to the static item's sourceNote for display, not a replacement —
  // keeps curatorial history readable in one place.
  sourceNoteAppend String?

  // When true, the automated embed-status check (check-embeds route) must
  // skip writing embedStatus/lastCheckedAt for this item entirely — a human
  // judgment call (e.g. a direct user report of "Video unavailable" that
  // contradicts what the YouTube Data API itself reports) takes precedence
  // over the next automated re-check. See rusofasil_media_content_policy
  // memory for why this exists: song-ty-uydyosh is a confirmed case where
  // the API disagrees with reality.
  manualOverride Boolean @default(false)

  updatedAt DateTime @updatedAt
}
