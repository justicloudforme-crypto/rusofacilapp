    "db:set-premium-only-word-games": "tsx prisma/set-premium-only-word-games.ts",
    "db:seed-glossary": "tsx prisma/seed-glossary.ts",
    "db:glossary-coverage-report": "tsx prisma/glossary-coverage-report.ts",
    "db:vocabulary-audit": "tsx prisma/vocabulary-idioms-audit.ts",
    "db:check-typos": "tsx prisma/check-typos.ts",
    "db:add-flashcards": "tsx prisma/add-flashcards.ts",
    "db:add-idioms": "tsx prisma/add-idioms.ts",
    "lint:stories": "tsx prisma/story-structure-lint.ts",
    "db:grant-subscription": "tsx prisma/grant-subscription.ts",
    "db:backfill-audio-durations": "tsx prisma/backfill-audio-durations.ts",
    "db:backfill-reading-minutes": "tsx prisma/backfill-reading-minutes.ts",
    "db:tag-story-topics": "tsx prisma/tag-story-topics.ts",
    "db:migrate-related-story-ids": "tsx prisma/migrate-related-story-ids-to-titles.ts",
    "db:verify-related-story-links": "tsx prisma/verify-related-story-links.ts",
    "concat:story-audio": "tsx prisma/concat-story-audio.ts",
    "generate:story-audio": "tsx prisma/generate-story-audio.ts",
    "generate:story-audio-cast": "tsx prisma/generate-story-audio-cast.ts",
    "generate:glossary-audio": "tsx prisma/generate-glossary-audio.ts",
    "generate:lesson-audio": "tsx prisma/generate-lesson-audio.ts",
    "generate:exam-audio": "tsx prisma/generate-exam-audio.ts",
    "generate:flashcard-audio": "tsx prisma/generate-flashcard-audio.ts",
    "generate:flashcard-example-audio": "tsx prisma/generate-flashcard-example-audio.ts",
    "generate:idiom-audio": "tsx prisma/generate-idiom-audio.ts",
    "migrate:audio-to-blob": "tsx prisma/migrate-audio-to-blob.ts",
    "apply-audio-blob-urls": "tsx prisma/apply-audio-blob-urls.ts",
    "sync-audio-assets-to-turso": "tsx prisma/sync-audio-assets-to-turso.ts",
    "remap-audio-content-ids": "tsx prisma/remap-audio-content-ids.ts",
    "sync-media-overrides-to-turso": "tsx prisma/sync-media-overrides-to-turso.ts",
    "check:media-embeds": "tsx prisma/check-media-embeds.ts",
    "check:story-audio": "tsx prisma/check-story-audio.ts",
    "generate:word-games": "tsx prisma/generate-word-games.ts",
    "check:grammar": "tsx prisma/check-grammar.ts",
    "check:lessons": "tsx prisma/check-lessons-grammar.ts",
    "check:wordgames-clues": "tsx prisma/check-wordgames-clues.ts",
    "generate:media-subtitles": "tsx prisma/generate-media-subtitles.ts",
    "sync:to-production": "tsx prisma/sync-to-production.ts",
    "cap:sync": "cap sync",
    "cap:ios": "cap open ios",
    "cap:android": "cap open android"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.0",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
