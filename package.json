{
  "name": "rusofacilapp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "prisma generate",
    "build:tokens": "node scripts/build-tokens.mjs",
    "check:tokens": "node scripts/check-tokens.mjs",
    "check:rendered": "node scripts/check-rendered-surface.mjs --control",
    "check:layout": "node scripts/check-layout-geometry.mjs --control",
    "check:lesson-pages": "node scripts/check-every-lesson-renders.mjs --control",
    "check:frozen": "node scripts/check-frozen-delta.mjs",
    "check:no-db-in-tests": "node scripts/check-tests-touch-no-database.mjs",
    "dev": "next dev",
    "dev:clean": "rm -rf .next && next dev",
    "build": "tsx prisma/ensure-schema-sync.ts && next build --webpack",
    "analyze": "ANALYZE=true next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "pretypecheck": "next typegen",
    "typecheck": "tsc --noEmit",
    "verify": "npm run lint && npm run typecheck && npm run build && npm run check:rendered:local",
    "check:rendered:local": "node scripts/verify-rendered.mjs",
    "check:rendered:ci": "node scripts/verify-rendered.mjs --ci",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:set-owner": "tsx prisma/set-owner.ts",
    "db:seed-lessons": "tsx prisma/seed-lessons.ts",
    "db:seed-stories": "tsx prisma/seed-stories.ts",
    "db:set-free-trial-stories": "tsx prisma/set-free-trial-stories.ts",
