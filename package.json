    "@capgo/capacitor-media-session": "^8.0.30",
    "@libsql/client": "^0.17.4",
    "@prisma/adapter-better-sqlite3": "^7.9.1",
    "@prisma/adapter-libsql": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@react-pdf/renderer": "^4.6.0",
    "@revenuecat/purchases-capacitor": "^13.4.1",
