<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CAPACITOR_DEBUG</key>
	<string>$(CAPACITOR_DEBUG)</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<!--
	  Витринное имя, половина «б» долга 70. Решение владельца 09.09.2026:
	  подпись под иконкой — «RusoFácil», короче бренда сайта на четыре
	  буквы, потому что iOS обрезает подпись примерно на 12 знаках и
	  «RusoFácilapp» превратилось бы в «RusoFáci…». Совпадать с брендом
	  сайта (RusoFácilapp) она не обязана и намеренно не совпадает.
	  Значение сличается с APP_DISPLAY_NAME из src/lib/brand.ts сторожем
	  npm run check:brand — Xcode этот файл не читает, поэтому иначе как
	  сторожем эти пять литералов в трёх файлах не удержать.
	-->
	<key>CFBundleDisplayName</key>
	<string>RusoFácil</string>
	<!--
	  Микрофон: упражнение на произношение (VoiceRecorder.tsx) зовёт
	  navigator.mediaDevices.getUserMedia({ audio: true }) прямо из
	  WebView. Отсутствие этой строки на iOS — НЕ отказ в доступе:
	  система завершает процесс на первом же обращении, то есть
	  приложение падает при первом нажатии «записать». На вебе этого не
	  бывает и не могло случиться — там разрешение спрашивает браузер, а
	  наш манифест не участвует, поэтому ни один прогон в браузере
	  дефекта не видел.

	  Текст по-испански: приложение испаноязычное, локализации
	  InfoPlist.strings в проекте нет, и показана будет ровно эта
	  строка. Она называет, ЧТО приложение делает с доступом, — Apple
	  отбивает на ревью строки, которые просто просят разрешение.

	  Сторожит npm run check:native-permissions.
	-->
	<key>NSMicrophoneUsageDescription</key>
	<string>RusoFácilapp usa el micrófono para grabar tu pronunciación en los ejercicios de lectura y vocabulario y reproducírtela enseguida, para que puedas compararla con la del hablante nativo.</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<!--
	  Было `$(PRODUCT_NAME)`, а PRODUCT_NAME = "$(TARGET_NAME)", и таргет
	  называется App — то есть iOS показывала в Настройках и в списке
	  хранилища буквальное «App». На домашнем экране этого не видно:
	  там выигрывает CFBundleDisplayName. Незаполненный шаблон Capacitor,
	  а не опечатка бренда.
	-->
	<key>CFBundleName</key>
	<string>RusoFácil</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<!--
	  Dev-only: iOS blocks ALL cleartext (http://) navigation by default,
	  not just to "localhost" — capacitor.config.ts's server.cleartext
	  flag alone does NOT override this OS-level policy, an explicit ATS
	  exception is required too. Without this block, the WebView cannot
	  reach `server.url` (currently the LAN dev IP) at all and falls
	  straight to server.errorPath ("Sin conexión"). NSAllowsArbitraryLoads
	  is blanket rather than scoped to one IP because the dev IP changes
	  between networks (see capacitor.config.ts's own comment on that) —
	  scoping it would mean editing this file every time. MUST be removed
	  (or the app switched to HTTPS-only production origin) before a real
	  App Store / Play submission — Apple explicitly reviews for this.
	-->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
    <false/>
    <key>UISceneConfigurations</key>
    <dict>
      <key>UIWindowSceneSessionRoleApplication</key>
      <array>
        <dict>
            <key>UISceneConfigurationName</key>
            <string>Default Configuration</string>
            <key>UISceneDelegateClassName</key>
            <string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
            <key>UISceneStoryboardFile</key>
            <string>Main</string>
        </dict>
      </array>
    </dict>
	</dict>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>armv7</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>
</dict>
</plist>
