<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CAPACITOR_DEBUG</key>
	<string>$(CAPACITOR_DEBUG)</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<!--
	  Витринное имя, половина «б» долга 70. Решение владельца 09.09.2026:
	  подпись под иконкой — «RusoFácil», короче бренда сайта на четыре
	  буквы, потому что iOS обрезает подпись примерно на 12 знаках и
	  «RusoFácilapp» превратилось бы в «RusoFáci…». Совпадать с брендом
	  сайта (RusoFácilapp) она не обязана и намеренно не совпадает.
	  Значение сличается с APP_DISPLAY_NAME из src/lib/brand.ts сторожем
	  npm run check:brand — Xcode этот файл не читает, поэтому иначе как
	  сторожем эти пять литералов в трёх файлах не удержать.
	-->
	<key>CFBundleDisplayName</key>
	<string>RusoFácil</string>
	<!--
	  Микрофон: упражнение на произношение (VoiceRecorder.tsx) зовёт
	  navigator.mediaDevices.getUserMedia({ audio: true }) прямо из
	  WebView. Отсутствие этой строки на iOS — НЕ отказ в доступе:
	  система завершает процесс на первом же обращении, то есть
	  приложение падает при первом нажатии «записать». На вебе этого не
	  бывает и не могло случиться — там разрешение спрашивает браузер, а
	  наш манифест не участвует, поэтому ни один прогон в браузере
	  дефекта не видел.

	  Текст по-испански: приложение испаноязычное, локализации
	  InfoPlist.strings в проекте нет, и показана будет ровно эта
	  строка. Она называет, ЧТО приложение делает с доступом, — Apple
	  отбивает на ревью строки, которые просто просят разрешение.

	  Сторожит npm run check:native-permissions.
	-->
	<key>NSMicrophoneUsageDescription</key>
	<string>RusoFácilapp usa el micrófono para grabar tu pronunciación en los ejercicios de lectura y vocabulario y reproducírtela enseguida, para que puedas compararla con la del hablante nativo.</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<!--
	  Было `$(PRODUCT_NAME)`, а PRODUCT_NAME = "$(TARGET_NAME)", и таргет
	  называется App — то есть iOS показывала в Настройках и в списке
	  хранилища буквальное «App». На домашнем экране этого не видно:
	  там выигрывает CFBundleDisplayName. Незаполненный шаблон Capacitor,
	  а не опечатка бренда.
	-->
	<key>CFBundleName</key>
	<string>RusoFácil</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<!--
	  ПОСЛАБЛЕНИЯ ТРАНСПОРТА (`NSAppTransportSecurity` →
	  `NSAllowsArbitraryLoads`) ЗДЕСЬ БОЛЬШЕ НЕТ, И ЭТО ПРАВКА 09.09.2026
	  (долг 110). Оно стояло в этом файле, а `INFOPLIST_FILE` в
	  `project.pbxproj` был один и тот же у конфигураций `Debug` и
	  `Release`, — то есть послабление уехало бы в магазинный пакет ровно
	  так же, как на Android уезжал адрес домашней сети (замерено на
	  артефакте, 7.158 часть 1). Поймало бы это не наша проверка, а ревью
	  Apple.

	  Теперь блок живёт в `ios/App/App/Info-Debug.plist`, который читает
	  ТОЛЬКО конфигурация `Debug` (`INFOPLIST_FILE = App/Info-Debug.plist`).
	  В релизном пакете его физически неоткуда взять — как и
	  `usesCleartextTraffic` на Android, это устройство сборки, а не
	  договорённость.

	  Два файла обязаны расходиться РОВНО одним этим блоком: их сличает
	  побайтово `npm run check:ios-release-safety`, иначе витринное имя и
	  строка назначения микрофона зажили бы в двух экземплярах.
	-->
	<!-- ATS-DEBUG-ONLY:start -->
	<!--
	  ЭТОТ БЛОК — ЕДИНСТВЕННОЕ, ЧЕМ ЭТОТ ФАЙЛ ОТЛИЧАЕТСЯ ОТ `Info.plist`,
	  и это правило, а не наблюдение: `npm run check:ios-release-safety`
	  вырезает всё между маркерами `ATS-DEBUG-ONLY` и требует, чтобы
	  остаток совпал с `Info.plist` ПОБАЙТОВО. Любая правка витринного
	  имени, строки назначения микрофона или версии, сделанная в одном
	  файле и забытая в другом, роняет проверку.

	  ЗАЧЕМ ОН НУЖЕН. iOS блокирует ВЕСЬ незашифрованный (`http://`)
	  трафик на уровне системы — не только к `localhost`, — и флаг
	  `server.cleartext` из `capacitor.config.ts` этого не отменяет:
	  нужно явное послабление ATS. Без него WebView не может достучаться
	  до `next dev` на ноутбуке вовсе и падает сразу в
	  `server.errorPath` («Sin conexión»).

	  ПОЧЕМУ ПОСЛАБЛЕНИЕ СПЛОШНОЕ, А НЕ ПОД ОДИН АДРЕС. Адрес ноутбука
	  меняется от сети к сети (об этом же говорит комментарий в
	  `capacitor.config.ts`), и сузить его значило бы править этот файл
	  при каждом переезде. Цена сплошного послабления здесь нулевая: этот
	  plist в релизный пакет не попадает по устройству сборки.

	  ЧЕГО ПРОВЕРКА НЕ ДОКАЗЫВАЕТ. Что Xcode действительно развёл
	  конфигурации: `.ipa` собрать нечем, Xcode на машине нет, и
	  `project.pbxproj` разбирается регулярными выражениями. Первая
	  настоящая сборка на Mac обязана это перепроверить — долг 110 в этой
	  части остаётся открытым.
	-->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
	<!-- ATS-DEBUG-ONLY:end -->
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
    <false/>
    <key>UISceneConfigurations</key>
    <dict>
      <key>UIWindowSceneSessionRoleApplication</key>
      <array>
        <dict>
            <key>UISceneConfigurationName</key>
            <string>Default Configuration</string>
            <key>UISceneDelegateClassName</key>
            <string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
            <key>UISceneStoryboardFile</key>
            <string>Main</string>
        </dict>
      </array>
    </dict>
	</dict>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>armv7</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>
</dict>
</plist>
