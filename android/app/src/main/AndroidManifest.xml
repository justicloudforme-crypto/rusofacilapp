<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
      `android:usesCleartextTraffic` ЗДЕСЬ БОЛЬШЕ НЕТ, И ЭТО ПРАВКА
      09.09.2026 (долг 109). Он стоял в этом файле, то есть в наборе
      `main`, а значит попадал во ВСЕ варианты сборки — включая
      релизный. Замерено на артефакте: в `app-release-unsigned.apk` от
      09.09.2026 скомпилированный манифест нёс
      `usesCleartextTraffic=true`, и Play Console флажит ровно это в
      pre-launch report.

      Теперь атрибут живёт в `android/app/src/debug/AndroidManifest.xml` —
      наборе, который манифест-мерджер подмешивает ТОЛЬКО в отладочный
      вариант. В релизном варианте его физически неоткуда взять: это не
      договорённость и не проверка, а устройство сборки.
    -->
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      Микрофон: упражнение на произношение (VoiceRecorder.tsx) зовёт
      navigator.mediaDevices.getUserMedia({ audio: true }) прямо из
      WebView. Без этих строк система возвращает запрос отказанным БЕЗ
      диалога, и запись отказывает молча — на вебе такого не бывает, там
      разрешение спрашивает браузер.

      Разрешений ДВА, и это не перестраховка: BridgeWebChromeClient из
      @capacitor/android на android.webkit.resource.AUDIO_CAPTURE просит
      сразу MODIFY_AUDIO_SETTINGS и RECORD_AUDIO, а его колбэк считает
      выдачу успешной, только если разрешены ВСЕ запрошенные (первый же
      false в карте ответов даёт granted = false). Объявить одно
      RECORD_AUDIO — значит починить наполовину и оставить рекордер
      сломанным. Проверено чтением исходника плагина.

      Оба разрешения сторожит npm run check:native-permissions.
    -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
</manifest>
