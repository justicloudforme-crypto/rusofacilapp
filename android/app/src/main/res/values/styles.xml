<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
    </style>

    <!--
        ТЕМА ЗАПУСКА. Правка 15.09.2026, заход 7.197.

        БЫЛО: у этой темы стояло РОВНО ОДНО свойство —
        `android:background="@drawable/splash"`. Начиная с Android 12
        системная заставка это свойство не читает вовсе: она читает
        `windowSplashScreenBackground` и `windowSplashScreenAnimatedIcon`.
        Их здесь не было ни одного, поэтому на Android 16 (телефон
        владельца) от нажатия на иконку человек видел светлый пустой
        прямоугольник — ни знака, ни фирменного фона. Замер владельца:
        5,9 с такого экрана.

        СТАЛО: оба свойства названы, и названы БЕЗ префикса `android:` —
        это атрибуты библиотеки `androidx.core:core-splashscreen`, и
        именно в таком написании они работают и на Android 12+, и на
        всех версиях ниже через её же обратную совместимость. Написание
        с `android:` собралось бы молча и работало бы только с Android 12.

        `postSplashScreenTheme` обязателен: без него после ухода
        заставки окно остаётся в теме заставки, а не в теме приложения.

        Длительность анимации значка — 0: значок у нас не анимированный,
        и заставка обязана уйти ровно тогда, когда страница готова
        (см. `MainActivity`), а не досматривать свою анимацию.
    -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splashBackground</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="windowSplashScreenAnimationDuration">0</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
        <!-- Путь для Android 11 и старше, где системной заставки нет:
             там окно красится этим фоном, и это те же 26 файлов
             `drawable…/splash.png`, только теперь фирменные. -->
        <item name="android:background">@drawable/splash</item>
    </style>
</resources>
