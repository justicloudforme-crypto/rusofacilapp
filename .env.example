DATABASE_URL="file:./dev.db"

# Turso (libsql) — production database. When set, src/lib/db.ts connects to
# this remote database instead of the local dev.db file; leave both blank
# to keep using DATABASE_URL/dev.db locally. Get these from `turso db show
# <db-name> --url` and `turso db tokens create <db-name>`.
TURSO_DATABASE_URL=""
TURSO_AUTH_TOKEN=""

# Used to sign the session cookie (src/lib/session-token.ts) AND the
# password-reset/account-deletion email links (src/lib/verification-token.ts).
# Generate one with: openssl rand -hex 32
SESSION_SECRET=""

# Resend — transactional email only (password reset, account-deletion
# confirmation), free tier (100/day) is plenty at this app's scale. Leave
# blank to run in demo mode: src/lib/email.ts logs the email (including the
# reset/confirmation link) to the server console instead of sending it, so
# the full flow still works end-to-end locally without an account.
RESEND_API_KEY=""
# "Name <verified-sender@yourdomain.com>" — must be a domain verified in
# Resend. Leave blank to fall back to Resend's shared onboarding@resend.dev
# sender, which only works for testing (deliverability is unreliable for
# real recipients).
EMAIL_FROM=""

# Stripe — leave blank to run in local/demo mode: /api/checkout will
# activate a subscription directly instead of creating a real Checkout
# Session, and /api/webhooks/stripe will respond 503 until these are set.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_MONTHLY=""
STRIPE_PRICE_ANNUAL=""

# RevenueCat — native App Store / Play Billing subscriptions (mobile apps
# only, web stays on Stripe above). Leave blank to run in local/demo mode:
# /api/webhooks/revenuecat will respond 503 until this is set. The secret
# is a plain shared string configured in RevenueCat's dashboard webhook
# settings, sent back as `Authorization: Bearer <secret>` on every call —
# unlike Stripe there's no HMAC signature to verify. PRODUCT_MONTHLY/ANNUAL/
# LIFETIME are the store product identifiers (from App Store Connect / Play
# Console — see the .storekit test config in ios/App/App/ for the exact
# identifiers used locally) mapped to this app's own "monthly"/"annual"/
# "lifetime" plan ids. LIFETIME is a one-time non-consumable, not a
# subscription — see LIFETIME_PERIOD_END in the webhook route.
REVENUECAT_WEBHOOK_SECRET=""
REVENUECAT_PRODUCT_MONTHLY=""
REVENUECAT_PRODUCT_ANNUAL=""
REVENUECAT_PRODUCT_LIFETIME=""

# RevenueCat client SDK keys (src/lib/revenuecat-client.ts) — one per
# store, both public/embeddable-in-binary keys (not secrets, unlike
# REVENUECAT_WEBHOOK_SECRET above), NEXT_PUBLIC_ so the Capacitor WebView
# bundle can read them. Get these from the RevenueCat dashboard under
# each app's API Keys tab. A "test_" prefixed key is that app's sandbox
# key — fine for development, swap to the production key before a real
# store submission.
NEXT_PUBLIC_REVENUECAT_IOS_API_KEY=""
NEXT_PUBLIC_REVENUECAT_ANDROID_API_KEY=""

# Vercel Blob — persistent storage for voice-submission recordings
# (src/lib/voice-storage.ts). Leave blank to fall back to writing under
# public/ instead, which only actually works in `next dev` — Vercel's
# serverless functions have a read-only filesystem at request time, so
# without this set, uploads silently fail in production. Create a Blob
# store under the project's Storage tab in the Vercel dashboard; the token
# is then injected automatically, no manual copy-paste needed.
BLOB_READ_WRITE_TOKEN=""

# Gates /api/cron/backup (src/lib/backup.ts, vercel.json's daily cron
# entry) — Vercel automatically sends this exact value as the request's
# Authorization: Bearer header when it invokes a cron job, as long as the
# env var is named CRON_SECRET; the route rejects any request without a
# matching header, so this also blocks anyone from triggering a full DB
# dump by just guessing the URL. Generate with: openssl rand -hex 32
CRON_SECRET=""

# OpenAI Audio (TTS) — used only by `npm run generate:story-audio` to
# narrate the stories in public/audio/stories/. Leave blank to skip: the
# script prints setup instructions and exits without calling the API.
OPENAI_API_KEY=""

# Anthropic — used only by the admin "Lecciones de video" generator
# (/admin/video-lessons) to turn a YouTube video's Russian captions into a
# full VideoLessonData JSON. Leave blank to skip: the generator responds
# 503 until this is set. Optionally override ANTHROPIC_MODEL (default:
# claude-sonnet-5).
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL=""

# YouTube Data API v3 — used only by `npm run check:media-embeds` to
# re-validate that every /media gallery item's video still plays (catches
# retroactive Content-ID claims and terminated channels that neither
# yt-dlp nor YouTube's oEmbed API can reliably detect). Free tier is
# 10,000 units/day; a full catalog check costs ~3 units. Leave blank to
# skip: the script prints setup instructions and exits without calling
# the API. Create a key at
# https://console.cloud.google.com/apis/credentials (enable "YouTube Data
# API v3" on the project first).
YOUTUBE_API_KEY=""

# Upstash Redis — shared rate-limit counters and content TTL cache across
# serverless instances (see src/lib/rate-limit.ts, src/lib/ttl-cache.ts).
# Leave blank and both files fall back to an in-memory Map — fine for local
# dev, not fine for a multi-instance production deploy (each instance would
# get its own counters/cache, silently weakening login rate-limiting and
# defeating the point of the cache). Create a free database at
# https://console.upstash.com and copy its REST URL/token.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Sentry — production error tracking (sentry.client/server/edge.config.ts,
# src/instrumentation.ts, src/app/global-error.tsx). Leave every var below
# blank and the SDK stays inert (Sentry.init with dsn: undefined is a
# documented no-op) — safe default, nothing breaks without an account.
# Create a free project at https://sentry.io (Next.js platform) to get DSN.
# NEXT_PUBLIC_SENTRY_DSN is used by the browser bundle, SENTRY_DSN by
# server/edge code — same value, both are needed since only NEXT_PUBLIC_
# vars reach client code.
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_DSN=""
# Only needed to upload source maps at build time (readable stack traces in
# the Sentry UI instead of minified ones) — get an auth token from Sentry
# under Settings > Account > API > Auth Tokens (scope: project:releases),
# org/project slugs from the project's Settings page. Leave blank to build
# without source map upload; the build itself still succeeds.
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""

# The caption downloader (src/lib/video-lesson/youtubeCaptions.ts) shells
# out to the `yt-dlp` CLI to pull YouTube captions — plain unauthenticated
# fetches to YouTube's caption endpoint are now bot-blocked. Install it
# with `pip install yt-dlp` (or `brew install yt-dlp`) and make sure it's
# on the PATH of whatever process runs `next dev` / the server. The admin
# generator responds with a clear "missing_ytdlp" error if it's not found.
