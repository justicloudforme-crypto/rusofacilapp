diff --git a/.github/workflows/ci.yml b/.github/workflows/ci.yml
index f054369..5d4cc8e 100644
--- a/.github/workflows/ci.yml
+++ b/.github/workflows/ci.yml
@@ -92,6 +92,30 @@ jobs:
       - name: Run Playwright tests
         run: npm run test:e2e
 
+      # Debt 19. lint, typecheck and 465 unit tests were green for the ten
+      # days every lesson page on production rendered nothing but "Something
+      # went wrong" (incident №1). None of them opens a browser. This step
+      # does, and it is here rather than in a job of its own because this job
+      # has already installed Chromium and already built the app — a separate
+      # job would repeat npm ci, prisma generate, db push, the build and the
+      # browser install to run a two-minute check.
+      #
+      # Only for main: on a pull request that targets main, and on a push to
+      # main. Intermediate commits on a branch do not pay for it.
+      #
+      # The fixture is not optional. CI's database is empty (see the note
+      # above), and with no glossary rows GlossaryText builds no pattern, so
+      # incident №1 would not reproduce here even with the bug fully
+      # present. The fixture puts back the one thing that made it fatal: a
+      # term containing a hyphen.
+      - name: Seed the render fixture
+        if: github.event.pull_request.base.ref == 'main' || github.ref == 'refs/heads/main'
+        run: npx tsx scripts/seed-ci-render-fixture.mjs
+
+      - name: Rendered surface (real browser, after hydration)
+        if: github.event.pull_request.base.ref == 'main' || github.ref == 'refs/heads/main'
+        run: npm run check:rendered:ci
+
       - name: Upload Playwright report
         if: failure()
         uses: actions/upload-artifact@v4
